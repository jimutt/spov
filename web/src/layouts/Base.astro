---
//
// The two faces, bundled. Only these three stylesheets are imported, so
// only their WOFF2 files reach the build: the sans in both styles, the
// mono upright, each in the latin and latin-ext subsets.
//
// @decision(DL-056)
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css';
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.svelte';
import Logo from '../components/Logo.svelte';
import Identity from '../components/Identity.svelte';
import Icon from '../components/Icon.svelte';

interface Props {
  title: string;
  /**
   * Below `lg` the header scrolls away with the page instead of staying
   * on screen, for a page that brings its own bar (the session page).
   */
  stickyFromLg?: boolean;
}

const { title, stickyFromLg = false } = Astro.props;

// The nav's active item is known at build time: these are static pages.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const nav = [
  { href: '/', label: 'Sessions', match: ['/', '/session'] },
  // @decision(DL-060)
  { href: '/jobs/', label: 'Jobs', match: ['/jobs'] },
  { href: '/usage/', label: 'Usage', match: ['/usage'] },
  { href: '/tokens/', label: 'Tokens', match: ['/tokens'] },
  { href: '/settings/', label: 'Settings', match: ['/settings'] },
];
const current = nav.find((item) => item.match.some((m) => here === m || here.startsWith(`${m}/`)));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- resizes-content: an on-screen keyboard shrinks the page rather than
         covering it, so a bar docked to the bottom rides above the keys.
         @decision(DL-106) -->
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{title}</title>
    <!-- Carries its own colours: a favicon is fetched outside the page
         and cannot inherit currentColor. @decision(DL-056) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Before first paint, or the page flashes the wrong theme. Kept in
         sync with src/components/theme.ts by hand: a module import here
         would be deferred and defeat the point. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('spov-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch {
        /* storage unavailable; follow the OS */
      }
    </script>
    <!-- The faces' OFL texts travel with the files they cover. Copies of
         the packages' own, which fonts.test.ts keeps equal.
         @decision(DL-056) -->
    <link rel="license" href="/licenses/atkinson-hyperlegible-next.txt" title="Atkinson Hyperlegible Next: SIL Open Font License 1.1" />
    <link rel="license" href="/licenses/atkinson-hyperlegible-mono.txt" title="Atkinson Hyperlegible Mono: SIL Open Font License 1.1" />
  </head>
  <body class="bg-paper text-ink">
    <!-- Sticky, so the session page can follow the end of a growing
         transcript. Needs an opaque background — bg-raised — since the
         transcript scrolls under it.
         @decision(DL-057) -->
    <!-- Sticky, so the session page can follow the end of a growing
         transcript. Needs an opaque background — bg-raised — since the
         transcript scrolls under it. Below `md` it is one bar: the
         wordmark and a menu button, with the navigation, the account
         and the theme in the panel the button opens. The same elements
         are the desktop row, so each is rendered once.
         @decision(DL-057) @decision(DL-106) -->
    <header
      class:list={[
        'group top-0 z-20 flex items-center gap-x-7 border-b border-rule bg-raised px-4 py-1.5 md:px-6 md:py-2.5',
        stickyFromLg ? 'max-lg:relative lg:sticky' : 'sticky',
      ]}
      data-menu="closed"
    >
      <!-- Decorative: the name is right beside it in text. The wordmark
           is the name alone, in the UI face.
           @decision(DL-056) -->
      <a
        href="/"
        class="flex items-center gap-2 text-[17px] font-bold tracking-[-0.01em] text-ink no-underline focus-visible:outline-2 focus-visible:outline-olive focus-visible:outline-offset-[3px]"
      >
        <Logo size={20} />
        <span>spov</span>
      </a>
      <button
        type="button"
        class="-mr-2 ml-auto inline-flex cursor-pointer items-center gap-2 rounded-ctl border-0 bg-transparent px-2 py-2 text-base text-ink focus-visible:outline-2 focus-visible:outline-olive focus-visible:outline-offset-2 md:hidden"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-button
      >
        <span>{current?.label ?? 'Menu'}</span>
        <Icon name="menu" class="size-5 group-data-[menu=open]:hidden" />
        <Icon name="cross" class="hidden size-5 group-data-[menu=open]:block" />
      </button>
      <div
        id="site-menu"
        class="absolute inset-x-0 top-full hidden flex-col gap-1 border-b border-rule bg-raised px-4 pb-3 shadow-sm max-md:group-data-[menu=open]:flex md:contents"
      >
        <nav class="flex flex-col text-base text-soft md:flex-row md:flex-wrap md:gap-x-5">
          {
            nav.map((item) => {
              const on = item.match.some((m) => here === m || here.startsWith(`${m}/`));
              return (
                <a
                  href={item.href}
                  class:list={[
                    'border-olive py-2.5 no-underline hover:text-ink focus-visible:outline-2 focus-visible:outline-olive focus-visible:outline-offset-[3px] max-md:border-l-[3px] max-md:pl-3 md:border-b-2 md:pt-1.5 md:pb-1',
                    on ? 'font-medium text-ink' : 'border-transparent text-soft',
                  ]}
                  aria-current={on ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
        <div class="mt-1 flex items-center justify-between gap-4 border-t border-rule pt-3 md:ml-auto md:mt-0 md:border-0 md:p-0">
          <Identity client:load />
          <ThemeToggle client:load />
        </div>
      </div>
    </header>
    <!-- --main-pad-y rather than a utility class, so a sticky element
         inside can stick at exactly the offset it already sits at — the
         sticky offset and the natural position are one number, written
         once. @decision(DL-057) -->
    <main class="mx-auto max-w-[var(--page-w)] px-[var(--page-pad-x)] py-[var(--main-pad-y)]">
      <slot />
    </main>
    <!-- The menu button of the one-bar header. Closed by Escape, by a
         press anywhere outside the header, and by following a link,
         which is a page load. @decision(DL-106) -->
    <script is:inline>
      (() => {
        const header = document.querySelector('header');
        const button = header && header.querySelector('[data-menu-button]');
        if (!header || !button) return;
        const set = (open) => {
          header.dataset.menu = open ? 'open' : 'closed';
          button.setAttribute('aria-expanded', String(open));
        };
        button.addEventListener('click', () => set(header.dataset.menu !== 'open'));
        document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
        document.addEventListener('click', (e) => header.contains(e.target) || set(false));
      })();
    </script>
    <!-- The header's height, published as --header-h so a sticky
         element below it can clear it. Measured rather than written
         down: the header wraps on a narrow viewport and follows the
         type scale, so a stale literal reads as a z-index bug rather
         than a wrong number. The property's own fallback only has to be
         close, for before this runs or if it never does.
         @decision(DL-057) -->
    <script is:inline>
      (() => {
        const header = document.querySelector('header');
        if (!header) return;
        const publish = () =>
          document.documentElement.style.setProperty(
            '--header-h',
            `${Math.round(header.getBoundingClientRect().height)}px`,
          );
        publish();
        if (typeof ResizeObserver !== 'undefined') new ResizeObserver(publish).observe(header);
        else addEventListener('resize', publish);
      })();
    </script>
  </body>
</html>
