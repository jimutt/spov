# Copy to deploy/kamal/.kamal/secrets (gitignored, kept out of the image's
# build context) and fill in. Kamal refuses to deploy while a secret that
# deploy.yml lists is missing from that file, so every name below must be
# present; the optional ones may be left empty (`NAME=`), which the server
# reads as unset. Values may also come from a password manager:
# https://kamal-deploy.org/docs/commands/secrets/
#
# @decision(DL-010)

# Required.
KAMAL_REGISTRY_PASSWORD=
# At least 32 characters; the server refuses a shorter one: openssl rand -hex 32
SPOV_SERVER_TOKEN=
SPOV_DATABASE_URL=postgres://spov:<password>@<host>:5432/spov?sslmode=require
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Browser sign-in (deploy/README.md#browser-login).
SPOV_GITHUB_OAUTH_CLIENT_ID=
SPOV_GITHUB_OAUTH_CLIENT_SECRET=

# Recommended: seals the credentials people store; unset, the server stores
# none and answers 501. 32 bytes, base64: openssl rand -base64 32
SPOV_CREDENTIAL_KEY=

# Optional: the organisation's GitHub App (deploy/README.md#credentials).
SPOV_GITHUB_APP_ID=
SPOV_GITHUB_APP_PRIVATE_KEY=
# Optional: the prep pass's model key (deploy/README.md#preparing-a-jobs-goal).
ANTHROPIC_API_KEY=

# Only during a key rotation, after uncommenting it in deploy.yml.
# SPOV_CREDENTIAL_KEY_OLD=
# Only with the Postgres accessory uncommented in deploy.yml.
# POSTGRES_PASSWORD=
