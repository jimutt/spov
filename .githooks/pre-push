#!/usr/bin/env bash
# Run scripts/check.sh before a push, while CI cannot run.
# Install once per clone: git config core.hooksPath .githooks
# Skip one push with `git push --no-verify`. SKIP_WEB and SKIP_LINT are
# passed through to check.sh.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
pushing=0
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one per ref.
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue # a branch deletion
  pushing=1
  # check.sh checks the working tree, so it only vouches for HEAD.
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: pushing $local_sha, which is not HEAD ($head)." >&2
    echo "Check it out and push again, or push with --no-verify." >&2
    exit 1
  fi
done
[ "$pushing" = 0 ] && exit 0

if ! git diff --quiet HEAD --; then
  echo "pre-push: the working tree has uncommitted changes, so check.sh would not be checking what is pushed." >&2
  echo "Commit or stash them, or push with --no-verify." >&2
  exit 1
fi

echo "pre-push: running scripts/check.sh (git push --no-verify skips it)"
# Git gives a hook the repository it runs for in these variables, as an
# absolute path in a linked worktree. Tests that make throwaway
# repositories inherit them and then rewrite this one's config and
# branches, so check.sh runs without them.
exec env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_PREFIX \
  -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES bash scripts/check.sh
